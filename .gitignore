# ─── Python / venv ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.ruff_cache/
.pytest_cache/

# ─── OS / IDE ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# ─── Obsidian per-user state under docs/ ──────────────────────────
docs/.obsidian/workspace*.json
docs/.obsidian/hotkeys.json
docs/.obsidian/graph.json
docs/.obsidian/plugins/
docs/.obsidian/themes/
docs/.obsidian/core-plugins-migration.json

# ─── Tokens ───────────────────────────────────────────────────────
# Canonical stores live OUTSIDE the repo — ~/.tokens on local,
# /workspace/.tokens on RunPod. These rules catch in-repo accidents.
.tokens/
*.token
.env
.env.*
.env_*

# ─── HTML output (reproducible from scripts) ──────────────────────
*.html

# ─── runtime artefacts ──────────────────────────────────
# Too big for git; HF-backed via cache.save_checkpoint auto-push on
# ephemeral pods. manifest.jsonl + per-cell metrics.json ARE tracked
# (small JSON, cross-agent visibility); depth-2 binaries are not.
results/runs/*/log.txt
results/runs/*/*.pt
results/runs/*/*.safetensors
results/runs/*/*.ckpt
results/runs/*/cache/
results/act_cache/
checkpoints/*/*.pt
checkpoints/*/*.safetensors
checkpoints/local/
hf_cache/

# Mini-sweep logs
logs/

# Benchmark run logs (regenerable stdout; not results — keep out of git)
experiments/**/results/*.log

# ─── em-redo runtime artefacts (runpod-c, 2026-07-23) ─────────────
# Framework real-LM data caches are machine-local memmaps (built by
# build_em_train_cache.py at the runner's keyed location); traces.json
# is the re-ported Ward stage-A data (see its ATTRIBUTION.md). Both
# must not dirty the tree for the runner's code-version gate.
results/data_cache/
results/probe_cache/
results/c7_backtracking/stage_a/traces.json

# ─── paper/ is a read-only source snapshot (agent context, not built here) ──
# Defensive: if anyone does run latex in paper/, keep the cruft out of git.
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/*.toc
paper/*.pdf

# ─── Private, local-only material (meeting transcripts, etc.) — NEVER commit ─
# Contains private information. Only the README pointer is tracked.
private/**
!private/README.md

# Claude-harness session lock (machine state; dirties every session's tree if tracked)
.claude/scheduled_tasks.lock
